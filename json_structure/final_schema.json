{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Repository Recommendation Schema",
  "description": "Schema for evidence-based recommendations for population health care management teams",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "role",
    "implementation_guidance",
    "expected_outcomes",
    "target_population",
    "citation",
    "evidence_level",
    "tags",
    "last_updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the recommendation"
    },
    "title": {
      "type": "string",
      "description": "Descriptive title of the recommendation"
    },
    "domain": {
      "type": "string",
      "description": "Clinical or social domain the recommendation belongs to",
      "enum": [
        "Diabetes",
        "Hypertension",
        "Depression",
        "Anxiety",
        "Substance Use",
        "Housing",
        "Food Security",
        "Transportation",
        "Asthma",
        "COPD",
        "Heart Failure",
        "Preventive Screenings",
        "Medication Adherence",
        "Care Transitions",
        "CKD",
        "Post MI",
        "Post Stroke",
        "HIV",
        "Vaccination",
        "EPSDT",
        "Prenatal",
        "Postnatal"
      ]
    },
    "role": {
      "type": "string",
      "description": "Professional role responsible for implementing the recommendation",
      "enum": [
        "Primary Care Provider",
        "Nurse Care Manager",
        "Community Health Worker",
        "Social Worker",
        "Pharmacist",
        "Behavioral Health Provider",
        "Care Coordinator",
        "Doula"
      ]
    },
    "implementation_guidance": {
      "type": "string",
      "description": "Detailed steps for implementing the recommendation"
    },
    "expected_outcomes": {
      "type": "string",
      "description": "Expected results from implementing the recommendation"
    },
    "target_population": {
      "type": "string",
      "description": "Specific population the recommendation targets"
    },
    "citation": {
      "type": "string",
      "description": "Source citation in JAMA/AMA format"
    },
    "evidence_level": {
      "type": "string",
      "description": "Strength of evidence supporting the recommendation",
      "enum": [
        "A - Strong",
        "B - Moderate",
        "C - Limited"
      ]
    },
    "tags": {
      "type": "array",
      "description": "Keywords for filtering and categorization",
      "items": {
        "type": "string"
      }
    },
    "last_updated": {
      "type": "string",
      "description": "Date when the recommendation was last updated (YYYY-MM-DD)",
      "format": "date"
    }
  }
}
